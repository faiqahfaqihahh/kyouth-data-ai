# Copy this file to .env and set your values before running the project.

# Required: Your Anthropic API key (https://console.anthropic.com/)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Backend URL for frontend communication
# For Docker Compose: use the service name 'backend'
# For local development: use http://localhost:8001
BACKEND_URL=http://backend:8001

# Optional: Database configuration
# DB_URL defaults to week_2/resources/jobs_d1.db
DB_URL=week_2/resources/jobs_d1.db

# Optional: Google Generative AI API key (if using google-genai)
# Uncomment and set if you plan to use Google's GenAI models
# GOOGLE_GENAI_API_KEY=your_google_api_key_here
