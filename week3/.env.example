# Copy this file to .env and set your values before running the project.

# Required: Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# URL the frontend uses to reach the backend.
# Keep as-is for docker compose (Docker DNS resolves the service name).
# Change to http://localhost:8001 for local development without Docker.
BACKEND_URL=http://backend:8001
