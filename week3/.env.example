# Google Gemini API key
# Get yours at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Path to the SQLite database from week 2
DB_URL=week_2/resources/jobs_d1.db

# Ollama host — use localhost for local dev, http://ollama:11434 for Docker
OLLAMA_HOST=http://localhost:11434

# URL of the backend service
# Use localhost for local dev, http://backend: for Docker
BACKEND_URL=http://localhost:(with your local port set here)